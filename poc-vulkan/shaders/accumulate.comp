#version 450
// ── accumulate.comp — the native-Vulkan original of accumulate.wgsl ──────────────
// Same algorithm as the WebGPU version: one GPU thread per event in the per-frame
// [lo, lo+count) slice, atomicAdd into the persistent per-player counters, O(new events)
// per frame, no readback. The differences are pure Vulkan/GLSL plumbing vs WGSL:
//   • `local_size_x = 64`  is GLSL's `@workgroup_size(64)`.
//   • `gl_GlobalInvocationID.x`  is `global_invocation_id.x`.
//   • std430 `buffer` blocks are storage buffers; `readonly` ⇒ WGSL `read`, plain ⇒
//     `read_write`. The `binding =` numbers map to descriptor-set slots (the host wires
//     them in main.c), exactly as @binding does in WGSL.
//   • PUSH CONSTANTS (the `pc` block): Vulkan's tiny, fast, no-buffer way to pass a few
//     per-dispatch values — here the {lo, count} window. WebGPU has no push constants, so
//     accumulate.wgsl uses a small uniform buffer (`Win`) instead. That's the only
//     structural change between the two.
layout(local_size_x = 64) in;

// events[] is packed 3 uints per event: player, stat (0=HR, 1=SB), count.
layout(std430, binding = 0) readonly buffer Events { uint events[]; };
layout(std430, binding = 1)          buffer Hr     { uint hr[]; };
layout(std430, binding = 2)          buffer Sb     { uint sb[]; };

layout(push_constant) uniform PC { uint lo; uint count; } pc;

void main() {
    uint g = gl_GlobalInvocationID.x;       // this thread's slot within the slice
    if (g >= pc.count) return;              // guard the partial final workgroup
    uint e      = (pc.lo + g) * 3u;         // 3 uints per event
    uint player = events[e + 0u];
    uint stat   = events[e + 1u];           // 0 = HR, 1 = SB
    uint cnt    = events[e + 2u];
    // atomicAdd: concurrent threads in the slice may hit the same player → serialise.
    if (stat == 0u) atomicAdd(hr[player], cnt);
    else            atomicAdd(sb[player], cnt);
}
